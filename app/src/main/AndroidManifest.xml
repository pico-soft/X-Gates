<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for xray to create/listen on TCP sockets (inet GID); without it socket() → EPERM -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityManager (сосуществование с чужим VPN: getActiveNetwork / getNetworkCapabilities /
         allNetworks / registerNetworkCallback). Обычное разрешение, выдаётся при установке. Без него —
         SecurityException в фоне убивает процесс при старте (Промпт 66). bindProcessToNetwork/getDefaultProxy
         разрешений не требуют. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service, чтобы xray жил в фоне (non-VPN, тип specialUse) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Runtime на Android 13+ (при отказе прокси работает, нотификация скрыта) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Установка обновления из сети (Промпт 70): запускаем СИСТЕМНЫЙ установщик, пользователь
         подтверждает сам. Тихой установки нет. Право «неизвестные источники» спрашивается per-app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Исключение из энергосбережения (Промпт 117): без него Samsung/Doze убивает фоновый сервис,
         прокси перестаёт работать для Телеграма/браузера. Не удобство, а УСЛОВИЕ работы в фоне —
         перезапуск после убийства (Промпт 115) помогает лишь когда система согласна перезапустить,
         а из «спящих» она не поднимает вовсе. Позволяет ПОПРОСИТЬ исключение (системный диалог). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Точный будильник цикла монитора (Промпт 118): корутинная пауза засыпает вместе с CPU в Doze
         (142 цикла за 46ч вместо 1380). setExactAndAllowWhileIdle срабатывает и в Doze. Исключение из
         энергосбережения (Промпт 117) авто-выдаёт это право; canScheduleExactAlarms() проверяем в рантайме,
         при отказе — деградация до setAndAllowWhileIdle (неточный, но тоже в Doze), не молчим. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Удержать CPU на время одного цикла проверки (иначе после срабатывания будильника CPU уснёт посреди пробы). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".XrayApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XrayProxyDroid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.XrayProxyDroid"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.XrayProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local SOCKS/HTTP proxy (xray-core), no VpnService" />
        </service>

        <!-- Отдаём скачанный APK обновления системному установщику через content:// (Промпт 70).
             Файл лежит в приватном filesDir/updates (не в общих загрузках). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>